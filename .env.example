# ============================================
# BDSS - 公司联系电话爬虫 环境变量配置
# ============================================
# 复制此文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================

# ---------- 百度地图 API ----------
# 申请地址: https://lbsyun.baidu.com/apiconsole/key
# 留空则走页面抓取降级（API 通道不可用）
BAIDU_MAP_AK=

# ---------- AI 搜索（可选，新增第六引擎）----------
# 支持 OpenAI / Claude / DeepSeek 等兼容 API
# API Key（必填，否则 --engine ai 会报错）
BDSS_AI_API_KEY=
# 模型名（默认 gpt-4o-mini）
BDSS_AI_MODEL=gpt-4o-mini
# API 地址（默认 OpenAI；DeepSeek: https://api.deepseek.com/v1）
BDSS_AI_BASE_URL=https://api.openai.com/v1

# ---------- 代理配置 ----------
# 可选。启动 Playwright 浏览器时使用的代理地址
# 格式: http://user:pass@host:port
PROXY=

# ---------- 搜索默认值 ----------
# 默认引擎 (baidu / google / bing / sogou)
ENGINE_DEFAULT=baidu

# 每个引擎打开结果数
MAX_RESULTS=5

# 请求间隔（毫秒），避免触发反爬
DELAY_MS=0

# ---------- 浏览器 ----------
# 是否显示浏览器窗口（调试用）
VISIBLE=false
